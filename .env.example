# Copy this file to .env.local and fill it in. Never commit .env.local.

# Your live domain (used in links, the sitemap and emails)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Order emails ────────────────────────────────────────────────────────────
# The mail account that sends the order emails (to you and to the customer).
# Gmail: host smtp.gmail.com, port 465, user = your address, pass = an "App password"
#        (Google Account → Security → 2-Step Verification → App passwords), not your login password.
# Zoho / GoDaddy / any business mailbox works the same way with its own SMTP host.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: how the sender appears, and where new-order emails go (both default to SMTP_USER)
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=
